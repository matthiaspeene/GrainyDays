{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build VST3 (Release)",
            "type": "shell",
            "command": "make",
            "args": ["-j", "CONFIG=Release", "VST3"],
            "options": {
                "cwd": "${workspaceFolder}/Builds/LinuxMakefile"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Builds build/Sammy.vst3 and copies it to ~/.vst3."
        },
        {
            "label": "Build VST3 (Debug)",
            "type": "shell",
            "command": "make",
            "args": ["-j", "CONFIG=Debug", "VST3"],
            "options": {
                "cwd": "${workspaceFolder}/Builds/LinuxMakefile"
            },
            "problemMatcher": ["$gcc"],
            "detail": "Builds a symbol-rich VST3 and copies it to ~/.vst3 for DAW debugging."
        },
        {
            "label": "Build Standalone (Debug)",
            "type": "shell",
            "command": "make",
            "args": ["-j", "CONFIG=Debug", "Standalone"],
            "options": {
                "cwd": "${workspaceFolder}/Builds/LinuxMakefile"
            },
            "problemMatcher": ["$gcc"],
            "detail": "Builds the JUCE standalone version for direct debugging."
        }
    ]
}
